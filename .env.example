# Code-Wave AI Assistant Environment Variables
# Copy this file to .env and set your keys:

# OpenRouter API (Recommended for LLMs - see challenge doc Section 9.2)
# Free models like 'meta-llama/llama-3.3-70b-instruct:free' work without a card.
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Embedding Provider: 'local' (offline all-MiniLM-L6-v2) or 'voyage' (cloud voyage-4-lite)
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=

# Cache directory for frugal token usage
CACHE_ENABLED=true

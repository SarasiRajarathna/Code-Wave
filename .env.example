# ==============================================================================
# Code-Wave Environment Configuration Template
# ==============================================================================

# OpenRouter API Key (Optional: for cloud LLM synthesis and reasoning)
# If left empty, the system automatically falls back to offline grounded synthesis.
OPENROUTER_API_KEY=

# OpenRouter Model Identifier
# Default free models: "meta-llama/llama-3.3-70b-instruct:free", "openrouter/free"
OPENROUTER_MODEL=openrouter/free

# Voyage AI API Key (Optional: for voyage-4-lite remote embeddings)
# If left empty, the system defaults to local sentence-transformers (all-MiniLM-L6-v2).
VOYAGE_API_KEY=
